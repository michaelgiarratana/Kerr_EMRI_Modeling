Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Animation", " ", "Block"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Defining", " ", "an", " ", "array", " ", "of", " ", "zeros", " ", "for", 
    " ", "later", " ", "population", " ", "of", " ", "movie", " ", 
    RowBox[{"frames", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dt", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tRange", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", "tf", ",", "dt"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"movievector", " ", "=", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", 
       RowBox[{"Length", "[", "tRange", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"k", "=", "1"}], ",", 
     RowBox[{"k", "<=", 
      RowBox[{"Length", "[", "tRange", "]"}]}], ",", 
     RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tk", " ", "=", " ", 
       RowBox[{"tRange", "[", 
        RowBox[{"[", "k", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"movievector", "[", 
        RowBox[{"[", "k", "]"}], "]"}], "=", "\[IndentingNewLine]", 
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Graphics3D", "[", 
            RowBox[{"{", 
             RowBox[{"Black", ",", 
              RowBox[{"Sphere", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
                RowBox[{"1", "+", 
                 RowBox[{"\[Sqrt]", 
                  RowBox[{"(", 
                   RowBox[{
                    SuperscriptBox["1", "2"], "-", 
                    SuperscriptBox["a", "2"]}], ")"}]}]}]}], "]"}]}], "}"}], 
            "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"ParametricPlot3D", "[", 
            RowBox[{
             RowBox[{"{", " ", 
              RowBox[{
               RowBox[{"X", "[", "t", "]"}], ",", 
               RowBox[{"Y", "[", "t", "]"}], ",", 
               RowBox[{"Z", "[", "t", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"t", ",", 
               RowBox[{"tk", "-", "10000"}], ",", "tk"}], "}"}], ",", 
             RowBox[{"PlotStyle", "->", 
              RowBox[{"Thickness", "[", "0.01", "]"}]}], ",", 
             RowBox[{"ColorFunction", "->", 
              RowBox[{"Function", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}], ",", 
                RowBox[{"Opacity", "[", 
                 RowBox[{
                  SuperscriptBox["t", "1"], ",", "Red"}], "]"}]}], "]"}]}]}], 
            "]"}]}], "}"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "375"}], ",", "200"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "250"}], ",", "150"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "200"}], ",", "150"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"Boxed", "->", "False"}], ",", 
         RowBox[{"PlotPoints", "->", "500"}], ",", 
         RowBox[{"ViewPoint", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "100"}], ",", "0", ",", "100"}], "}"}]}], ",", 
         RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<KerrEccNoAxes.mp4\>\"", ",", "movievector"}], 
    "]"}]}]}]], "Input",
